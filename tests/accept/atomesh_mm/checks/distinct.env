# The distinction check needs the engine's prefix cache, which the profile
# may turn off; the last occurrence of the flag wins.
ATOM_ARGS+=(--enable_prefix_caching)
# It reads ATOMesh's route log, so accept.sh refuses a topology without
# ATOMesh (direct).
REQUIRES_MESH=1
# Every request logs its routing decision (target mesh::route).
MESH_ARGS+=(--route-log-sample-rate 1)
