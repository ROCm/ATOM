# AtomRL release dependencies validated on MI355X (gfx950).
#
# Sourced by release/build_image.sh so release images use these exact versions.
#
# Validated: 2026-11-26 on 2 x 8 MI355X (gfx950), ROCm 7.2.4, PyTorch 2.10.0:
# rocm/atom-dev:atomrl-dapo-gfx950-rocm7.2.4-261125 (these pins; its flash_attn was
# added onto the first build) passed examples/run.sh's t0, t1 and t2 tiers.
# See release/VALIDATION.md.
#
# AITER is the exact checkout used by the validated development image.

# ATOM, AtomRL, and Lumen are installed from the current repository checkout.
# AITER is pinned below. MORI is inherited from atom-dev:latest
# (amd_mori_nightly 1.2.6.dev20261119).
AITER_REPO=https://github.com/ROCm/aiter.git
AITER_SHA=c813348adc360f077c9bd040ee8de68bb7ade0f7
MORI_PACKAGE_VERSION=1.2.6.dev20261119

# --- Base image and the pinned python deps that differ from it ---
# vllm-latest moves; the dated tag is the base this file's pins were validated on
# (its flydsl 0.5.0 is what AITER_SHA requires; the 20261124 base ships 0.5.3).
BASE_IMAGE=rocm/atom-dev:vllm-v0.31.0-nightly_20261119
# NVIDIA upstream megatron-core, which AtomRL's CPU CI pins and the Megatron engine
# needs (moe_enable_routing_replay). The ROCm fork's MORI dispatch is mounted with
# MEGATRON_PATH instead (examples/docs/08-release.md 8.1.2). The Megatron examples
# use the ROCm TransformerEngine/Apex revisions below.
MEGATRON_CORE_VERSION=0.18.2
APEX_SHA=daed85255d51476425080e7e6203f0bee6d7e4cc
TE_SHA=6e541a10419a6e31bdc98b1516db04eb81a463b6
# flash-attention ROCm (CK) build; the base has none, and 261119 carried this version.
FLASH_ATTN_REF=v2.8.3
