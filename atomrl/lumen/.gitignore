__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.so
*.o
.eggs/
/docs/
outputs/2026-*/
tunableop_results*.csv
.rocprofv3/
data/
*.parquet
wandb/
runs/
train_*.log
.claude/worktrees/
.claude/tmp-training-bugs.md

# Datasets staged by the Megatron launchers
examples/results/
examples/*/results/mock_data/
examples/*/results/c4_data/

# Run output: logs and shape dumps. Both depths are listed because
# the FSDP launcher points RESULTS_DIR at a per-run subdirectory, and a single
# `*` does not cross a slash.
examples/*/results/lumen_*.log
examples/qwen3/results/*.log
examples/*/results/**/*.log
examples/*/results/*.shapes.csv
examples/*/results/*.untuned.csv

# Profiler and tensorboard artifacts. Matched by extension, not directory, so
# the curated summaries alongside them stay tracked.
examples/*/results/tensorboard/
examples/*/results/**/events.out.tfevents.*
examples/*/results/**/*.pt.trace.json

examples/precision_matrix_runs.tsv
# Fetched or written by the example and benchmark scripts, not tracked.
examples/*/results/
benchmarks/results/
outputs/
