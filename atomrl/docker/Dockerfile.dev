# ATOM vLLM nightly already contains the ROCm-compatible vLLM plugin stack.
# Override with --build-arg BASE_IMAGE=... only for an explicitly validated pin.
ARG BASE_IMAGE=rocm/atom-dev:vllm-latest
FROM ${BASE_IMAGE}

WORKDIR /opt/atomrl

# ─── System build dependencies ───────────────────────────────────────────────
RUN apt-get update && \
    apt --fix-broken install -y && \
    apt-get install -y --no-install-recommends \
        build-essential git ninja-build cmake \
        libopenmpi-dev libibverbs-dev rdma-core libpci-dev \
        vim curl wget htop && \
    rm -rf /var/lib/apt/lists/*

# Copy the current ATOM checkout, including AtomRL and in-tree Lumen.
COPY . /opt/atomrl/ATOM

# ATOM uses the SPDX license string form, supported by setuptools 77+.
# Keep the vLLM runtime dependency range from the vLLM base image.
RUN pip install --upgrade "setuptools>=77,<80"

# Install Lumen development dependencies without allowing PyPI packages to
# replace the ROCm PyTorch stack supplied by rocm/atom-dev.
RUN pip install --no-deps \
        "torchao>=0.8,<0.10" \
        "peft>=0.9" && \
    pip install \
        pytest pytest-xdist \
        "huggingface_hub>=0.20" \
        "datasets>=2.16" \
        "transformers>=4.38" \
        setuptools-scm "numpy>=1.26.0,<=2.2.6" \
        "sentencepiece>=0.1.99" "protobuf>=6.31.1,<7" \
        "regex>=2023.0.0"

# Keep the AITER checkout from the base image only when it matches the
# requested upstream ref.  A newer ref is fetched and rebuilt in this image.
ARG AITER_REPO=https://github.com/ROCm/aiter.git
ARG AITER_REF=main
ENV AITER_DIR=/app/aiter-test
RUN set -eux; \
    latest="$(git ls-remote "${AITER_REPO}" "refs/heads/${AITER_REF}" | awk 'NR == 1 { print $1 }')" && \
    test -n "${latest}" && \
    current="$(git -C "${AITER_DIR}" rev-parse HEAD 2>/dev/null || true)" && \
    if [ "${current}" = "${latest}" ]; then \
        echo "Reusing AITER ${current} from the base image"; \
    else \
        echo "Updating AITER from ${current:-<missing>} to ${latest}"; \
        if [ -d "${AITER_DIR}/.git" ]; then \
            git -C "${AITER_DIR}" fetch --depth=1 origin "${AITER_REF}" && \
            git -C "${AITER_DIR}" checkout --detach "${latest}"; \
        else \
            rm -rf "${AITER_DIR}" && \
            git clone --depth=1 --branch "${AITER_REF}" "${AITER_REPO}" "${AITER_DIR}"; \
        fi; \
    fi; \
    flydsl_site="$(python -c 'import site; print(site.getsitepackages()[0])')"; \
    find "${flydsl_site}" -maxdepth 1 -iname 'flydsl*' -exec rm -rf {} +; \
    pip install -r "${AITER_DIR}/requirements.txt"; \
    pip install --no-build-isolation --no-deps -e "${AITER_DIR}"

# Install ATOM and AtomRL as separate distributions. The AtomRL package owns
# its RL-only dependencies (Ray and OmegaConf); they must not enter atom.
RUN pip install datasets "math_verify[antlr4_13_2]" \
        safetensors pytest pytest-xdist ruff mypy && \
    pip install --no-deps accelerate && \
    cd /opt/atomrl/ATOM && \
    pip install --no-build-isolation --no-deps -e . && \
    LUMEN_BUILD_EXTENSIONS=1 pip install --no-build-isolation -e ./atomrl

# ─── torchao ─────────────────────────────────────────────────────────────────
RUN pip install --no-deps 'torchao>=0.8,<0.10'

RUN python -c "import torch; assert torch.version.hip is not None, 'ROCm PyTorch was replaced'; print(torch.__version__, torch.version.hip)"

# ─── Megatron-LM-AMD ────────────────────────────────────────────────────────
ARG MEGATRON_COMMIT=8dd45f5a51378ec1ee7937dee3c20d8626df4763
RUN git clone --recursive https://github.com/ROCm/Megatron-LM.git /opt/atomrl/megatron_lm && \
    cd /opt/atomrl/megatron_lm && git checkout ${MEGATRON_COMMIT} && \
    pip install -e . -U --force-reinstall --no-deps && \
    cd megatron/core/datasets && make

# Megatron's Transformer Engine layer specs require the ROCm TE build.  The
# base image contains Apex but not TransformerEngine, so example 7 otherwise
# fails during import with "TENorm is not defined".
ARG APEX_SHA=daed85255d51476425080e7e6203f0bee6d7e4cc
ARG TE_SHA=6e541a10419a6e31bdc98b1516db04eb81a463b6
COPY atomrl/release/build_apex_te.sh /tmp/build_apex_te.sh
RUN pip install onnxscript && \
    APEX_SHA="${APEX_SHA}" TE_SHA="${TE_SHA}" \
    PYTORCH_ROCM_ARCH=gfx950 GPU_ARCHS=gfx950 \
    bash /tmp/build_apex_te.sh

# ─── PYTHONPATH ──────────────────────────────────────────────────────────────
ENV RL_ROOT="/opt/atomrl"
ENV ATOM_DIR="/opt/atomrl/ATOM"
ENV PYTHONPATH="/opt/atomrl/megatron_lm:/opt/atomrl/ATOM:/app/aiter-test:/opt/atomrl/ATOM/atomrl:${PYTHONPATH:-}"

# ─── Runtime env (override HIP_VISIBLE_DEVICES at container launch) ─────────
ENV MORI_ENABLE_SDMA=1
ENV VLLM_USE_V1=1
ENV TORCHDYNAMO_DISABLE=1

# ─── ATOM/vLLM attention backend ────────────────────────────────────────────
ENV VLLM_ROCM_ATTN_BACKEND="ROCM_AITER_FA"
ENV VLLM_ROCM_ATTN_BACKEND_FALLBACK="ROCM_AITER_UNIFIED_ATTN"

RUN python -c "import torch, pathlib; print(pathlib.Path(torch.__file__).parent / 'lib')" \
        > /etc/ld.so.conf.d/torch.conf && ldconfig

WORKDIR /opt/atomrl/ATOM/atomrl

CMD ["/bin/bash"]
