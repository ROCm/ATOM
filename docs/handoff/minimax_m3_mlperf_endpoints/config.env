# config.env: everything that differs between machines. Every script sources it.
# One file for both node types; the server is TP4 on either:
#   MI455X (gfx1250), 4 GPUs: every GPU.
#   MI355X (gfx950),  8 GPUs: GPUS=0,1,4,5, the default below on a node with more than 4.

# An ATOM image for the node's arch whose python imports the mounted trees.
#   MI455X: e15-05 has ruili/m3stack-env:1030      MI355X: rocm/atom-dev:latest, or a rocm/atom-dev:nightly_* tag
IMAGE=${IMAGE:-ruili/m3stack-env:1030}
CONTAINER=${CONTAINER:-${USER}_m3ep} # the server container; named after you because the machines are shared
ATOM_DIR=${ATOM_DIR:-$HOME/code/m3_tg/ATOM}    # lirui927/ATOM lirui/m3-prefill-token-graph-v2
AITER_DIR=${AITER_DIR:-$HOME/code/m3_tg/aiter} # lirui927/aiter m3-stack-1030-tg
# Extra `docker run` arguments, e.g. a git worktree's main repository at its own path:
#   EXTRA_DOCKER_ARGS="-v $HOME/code/m3_fp8kv:$HOME/code/m3_fp8kv"
EXTRA_DOCKER_ARGS=${EXTRA_DOCKER_ARGS:-}

# Host paths of the target and the EAGLE3 draft; the container sees them at /models/<directory name>.
#   e15-05: /data/models/...   MI355X recipe: /shared_nfs/huggingface_models/amd/MiniMax-M3-MXFP4 and
#   /shared_nfs/huggingface_models/Inferact/MiniMax-M3-EAGLE3-GQA
MODEL_PATH=${MODEL_PATH:-/data/models/MiniMax-M3-MXFP4}
DRAFT_PATH=${DRAFT_PATH:-/data/models/MiniMax-M3-EAGLE3-GQA}
MODEL=$(basename "$MODEL_PATH")  # the served model name is /models/$MODEL
DRAFT=$(basename "$DRAFT_PATH")

# The GPUs the server uses, as ROCR_VISIBLE_DEVICES indices; empty = every GPU. On an 8-GPU MI355X the M3 agentic
# recipe takes two per NUMA node (0-3 sit on node 0, 4-7 on node 1): required once the CPU tier pins host memory,
# measured neutral without it.
NUM_GPUS=4                      # GPUs the server uses (TP4); tok/s/GPU divides by this
if [ -z "${GPUS:-}" ] && [ "$(grep -l '^simd_count [1-9]' /sys/class/kfd/kfd/topology/nodes/*/properties 2> /dev/null | wc -l)" -gt 4 ]; then
  GPUS=0,1,4,5
fi
GPUS=${GPUS:-}
MONO=${MONO:-}                  # ATOM_MONO_ENABLE (gfx950's decode megakernel); empty = ATOM's default, on

WORK=$HOME/m3ep                 # server logs ($WORK/logs, mounted at /logs)
CLIENT=$HOME/mlperf_ep          # the MLPerf Endpoints client, the dataset and the results, on the host
# Both on the host network: a second server on the node (the other half of an MI355X) needs two others.
API_PORT=${API_PORT:-8890}       # the server's OpenAI API: http://127.0.0.1:$API_PORT
ENGINE_PORT=${ENGINE_PORT:-8896} # ATOM --port, the tensor-parallel group's MASTER_PORT
