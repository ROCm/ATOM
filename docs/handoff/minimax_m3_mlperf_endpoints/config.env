# config.env: everything that differs between machines. Every script sources it.
# Defaults are the F01 layout of ../minimax_m3_prefill_token_graph/README.md; e15-05 values in the comments.

# Any gfx1250 ATOM image whose python can import the mounted trees (e15-05: ruili/m3stack-env:1030)
IMAGE=${IMAGE:-ruili/m3stack-env:1030}
CONTAINER=${USER}_m3ep          # the server container; named after you because the machines are shared
ATOM_DIR=${ATOM_DIR:-$HOME/code/m3_tg/ATOM}    # lirui927/ATOM lirui/m3-prefill-token-graph-v2 (e15-05: ~/code/m3_fp8kv/ATOM_m3_prefill_tg)
AITER_DIR=${AITER_DIR:-$HOME/code/m3_tg/aiter} # lirui927/aiter m3-stack-1030-tg (e15-05: ~/code/m3_fp8kv/aiter_tg)
# Extra `docker run` arguments, e.g. a git worktree's main repository at its own path:
#   EXTRA_DOCKER_ARGS="-v $HOME/code/m3_fp8kv:$HOME/code/m3_fp8kv"
EXTRA_DOCKER_ARGS=${EXTRA_DOCKER_ARGS:-}
MODEL_HOST_DIR=/data/models     # holds MiniMax-M3-MXFP4/ and MiniMax-M3-EAGLE3-GQA/; mounted at /models
MODEL=MiniMax-M3-MXFP4
DRAFT=MiniMax-M3-EAGLE3-GQA
WORK=$HOME/m3ep                 # server logs ($WORK/logs, mounted at /logs)
CLIENT=$HOME/mlperf_ep          # the MLPerf Endpoints client, the dataset and the results, on the host
API_PORT=8890                   # the server's OpenAI API: http://127.0.0.1:$API_PORT
NUM_GPUS=4                      # TP4 on one 4-GPU MI455X node; tok/s/GPU divides by this
