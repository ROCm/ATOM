# Settings of the 2026-11-01 Qwen3.5-35B-A3B MLPerf agentic points (README.mlperf-agentic.md).
# Load with:  set -a; . ./agentic_20261101.env; set +a
# DP4 attention + EP4 MoE and MTP-3 come from run_ep.sh at c > 16.

# fp8 KV cache
KV=fp8
# decode attention: token split into equal-size KV segments, 16-128 tiles a sequence
AITER_GFX12_TOKEN_SPLIT=1
AITER_GFX12_TOKEN_SPLIT_MIN_TILES=16
AITER_GFX12_TOKEN_SPLIT_MAX_TILES=128
# LM head replicated on each DP rank (no per-step logits all-gather)
ATOM_DP_LM_HEAD_MODE=default
# MoE: fp4 mori dispatch; the compact stage-1 path stays off (it hung all four GPUs on Qwen at c768)
MEGA_DISPATCH_WIRE=fp4
ATOM_MEGA_STAGE1_FUSED=0
# GDN state checkpoint images: 32 GiB GPU budget an engine, chain root + tip kept (ATOM #2884)
ATOM_STATE_CHECKPOINT_GPU_SIZE=32
ATOM_STATE_CHECKPOINT_DIAG=1
# API server: tokenize in 16 worker processes (ATOM #2888), segment tokenizer cache off
ATOM_TOKENIZE_PROCESSES=16
ATOM_TOKENIZE_CACHE_MB=0
ATOM_PRE_ENGINE_TIMING=1
# scheduler: DP prefill balance at token weight 28000, 16 decode steps after a prefill
ATOM_DP_PREFILL_BALANCE_TOKEN_WEIGHT=28000
ATOM_PREFILL_DECODE_INTERVAL=16
# client: the example's 10 h issue cap (the point is stopped after STOP_S), every trajectory to its end,
# the benchmark's own turn timeout; idle pooled connections kept 4 s (the example yaml sets 0.5 s)
CAP_MIN=600
STOP_FIRST=0
TURN_TIMEOUT=14400
CLIENT_MAX_IDLE=4
# The measured points ran without inline accuracy (an official result needs ACC_INLINE=1 and a
# NUM_TRAJ multiple of 613 on every point)
ACC_INLINE=0
