# Qwen3.6-35B-A3B MXFP4, 4 x MI455X, MLPerf Endpoints agentic: the 2026-11-21 settings, on top of agentic_20261101.env,
# agentic_20261107.env, agentic_20261119.env and agentic_20261120.env (README, 2026-11-21 section).
# agentic_20261120.env now applies at every point c64-c1024 (measured 2026-11-21 with fixed max on: c64 +1.7%, c256-c512
# +4.7..+6.0% together with LPT; without fixed max c384 +4.0%, c1024 158.0). Code: alizaidy/gfx1250-qwen-support plus the aiter LPT order and the c256-c512 decode
# configs (and, for the optional c64 lines, the ATOM/aiter low-concurrency decode change).

# 2D prefill attention: longest sequence first across the batch (bitwise; c384 +1.4%, c1024 +1.3%)
AITER_UA_2D_LPT=1

# Fixed-reference-max 2D prefill OFF by default (agentic_20261120.env turns it on): an accuracy concern was reported
# outside these runs. OPTIONAL: set AITER_UA_2D_FIXED_MAX=1 only where the point's accuracy check passes (10-minute
# runs here: c1024 0.566-0.5683, c384 0.5613-0.5622, c64 0.5597-0.566; official-length c1024 0.5627). Worth +1.1% at
# c1024 (158.0 -> 159.8) and +1.5% at c384 (405.2 -> 411.1) on 2026-11-21.
AITER_UA_2D_FIXED_MAX=0

# --- Optional, c32-c128 only: low-concurrency decode (set by the point, not here) ---
# Bitwise / same tokens, no served gain on their own; with the fp8 verify LM head c64 +1.3% (two runs each).
#   ATOM_FOLD_QKNORM_QKV_BF16_FP4PT=1 ATOM_FOLD_QKNORM_QKV_BF16_MAX_M=48 ATOM_MTP_DRAFT_LMHEAD_STATS=1
#   ATOM_HOSTNEXT_PINNED_NAT=1 ATOM_HOSTNEXT_FUSED_PROLOGUE=1
#   ATOM_HOSTFAST_TRITON_EXTRA=atom.model_ops.attentions.gdn_attn:_gdn_spec_decode_pad_kernel,atom.model_ops.fla_ops.replayssm:_replayssm_commit_kernel,atom.model_ops.attentions.early_meta:_early_meta_fix_kernel,atom.model_ops.attentions.early_meta:_early_gdn_accepted_kernel,atom.model_ops.attentions.early_meta:_early_prologue_kernel
# NUMERICAL: verify LM head in fp8 mx128 (accuracy -0.002..-0.0035 in 10-minute runs; c64 lowest 0.5589 vs the 0.5586
# gate): not in the measured defaults until an official-length run confirms the margin.
#   ATOM_VERIFY_LM_HEAD_FP8=1
