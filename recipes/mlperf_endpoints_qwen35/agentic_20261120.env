# Qwen3.6-35B-A3B MXFP4, 4 x MI455X, MLPerf Endpoints agentic: the 2026-11-20 c1024 settings, on top of
# agentic_20261101.env, agentic_20261107.env and agentic_20261119.env (README, 2026-11-20 section).
# Code: alizaidy/gfx1250-qwen-support with the c1024 decode GEMM configs (aiter), the fixed-reference-max 2D prefill
# (aiter) and ATOM_PREFILL_EARLY_PREP (ATOM). Measured at c1024 only; other points have not been run with these.

# decode attention split reduce: fewer speculatively loaded segments (bitwise; reduce 20 -> 9 us a call)
AITER_GFX12_SPLIT_REDUCE_ONESHOT_CONFIG=16,8,2
# prefill: schedule it while the previous decode runs; GDN checkpoint targets from pinned memory (both bitwise)
ATOM_EARLY_PREFILL_SCHEDULE=1
ATOM_PREFILL_EARLY_PREP=1
# no stream drain before GDN state copies (no numeric change; official-length run: no errored turns, accuracy 0.5627)
ATOM_STATE_OPS_DRAIN=0
# bf16 router + shared expert: the fused decode kernel up to 640 rows (aiter's c1024 decode GEMM configs)
ATOM_FUSED_ROUTER_SHARED_EXPERT_MAX_TOKENS=640
# NUMERICAL (not bitwise): fixed reference max in the 2D prefill attention (lower rms error than the running max);
# drop this line for the bitwise stack
AITER_UA_2D_FIXED_MAX=1

# --- c1024 point (set by the point, not here) ---
# KV=fp8_k4v4pt with ATOM_FOLD_QKNORM_QKV_FP4PT=1 ATOM_FOLD_QKNORM_QKV_MAX_M=48, but NOT the c64-tuned fp4pt split settings
# (AITER_GFX12_TOKEN_SPLIT_MIN_TILES_FP4PT=8 AITER_GFX12_TOKEN_SPLIT_PROGRAMS=512: 1.5-4% slower decode at 104-127 rows);
# the image's AITER_GFX12_TOKEN_SPLIT_MIN_TILES_FP4PT=16 applies. Interval 4, PREFILL_TOKENS=16384, max_num_seqs 320.
# The measured runs also set CAPS (README); it is neutral at c1024.
