# Best measured configuration of 2026-11-05 (kapi_c1024_B: 64,338.5 tok/s at 138.3 tok/s/user, c1024, quick-scored),
# on top of agentic_20261101.env (source that first). The 2026-11-04 settings, then the 11-05 additions.
DP_EP=0
DP_INDEP=1
ATOM_DP_DRAFT_ARGMAX=0
KV=fp8_k4v8
BLOCK_SIZE=128
ATOM_DP_PREFILL_BALANCE_TOKEN_WEIGHT=53000
ATOM_DP_PREFILL_BALANCE_SLACK=0.02
ATOM_DP_PLACE_BY_CONTEXT=1
ANY_CONCURRENCY=1
ATOM_FUSED_MOE_TAIL_NORM=1
ATOM_SHARED_EXPERT_GATED_GEMM=1
ATOM_MTP_SELECT_ROWS_BEFORE_MOE=1
ATOM_MTP_FUSED_EMBED_PRE_FC_NORM=1
ATOM_MTP_FUSED_DRAFT_GLUE=1
ATOM_FUSED_ZERO_FILL=1
ATOM_FAST_PREFILL_BATCH_IDS=1
AITER_GDN_VERIFY_MATRIX=1
AITER_GDN_VERIFY_CHUNK_WARPS=8
AITER_GFX12_TOKEN_SPLIT_FUSED=1
ATOM_FUSED_TOPK_TOPP_SAMPLE=1
# 2026-11-05 kernels (ROCm/ATOM#3045): split-KV attention reduce; router + shared expert in one kernel (decode) or
# one GEMM (prefill); top-k + route/psum + MXFP4 quant fused (decode 1 launch, prefill 2); gather-reduce + tail
# RMSNorm fused, software-pipelined at prefill sizes.
ATOM_UA_SPLIT_REDUCE=1
ATOM_FUSED_ROUTER_SHARED_EXPERT=1
ATOM_MOE_FUSED_TOPK_ROUTE_QUANT=1
ATOM_MOE_GATHER_TAIL_NORM=1
ATOM_MOE_GATHER_TAIL_NORM_PIPE=1
# 2026-11-05 API server (ROCm/ATOM#3018): request preparation (JSON parse, validation, chat template, encode, prefix
# hashes) in 64 tokenize worker processes instead of on the event loop. +22% tok/s at c1024.
ATOM_API_OFFLOAD_PREPROCESS=1
ATOM_TOKENIZE_PROCESSES=64
