# Best measured configuration of 2026-11-06/07: Qwen3.6-35B-A3B MXFP4, DP4 attention with every expert on every GPU
# (independent ranks), MTP-3, A8K4V8 KV cache, MLPerf Endpoints agentic. On top of agentic_20261101.env (source that
# first); run_point_20261107.sh sources both and sets the decode interval per concurrency.
MODEL=/data/Qwen3.6-35B-A3B-MXFP4
DP_EP=0
DP_INDEP=1
ATOM_DP_DRAFT_ARGMAX=0
KV=fp8_k4v8
BLOCK_SIZE=128
ATOM_DP_PREFILL_BALANCE_TOKEN_WEIGHT=53000
ATOM_DP_PREFILL_BALANCE_SLACK=0.02
ATOM_DP_PLACE_BY_CONTEXT=1
ANY_CONCURRENCY=1
ATOM_FUSED_MOE_TAIL_NORM=1
ATOM_SHARED_EXPERT_GATED_GEMM=1
ATOM_MTP_SELECT_ROWS_BEFORE_MOE=1
ATOM_MTP_FUSED_EMBED_PRE_FC_NORM=1
ATOM_MTP_FUSED_DRAFT_GLUE=1
ATOM_FUSED_ZERO_FILL=1
ATOM_FAST_PREFILL_BATCH_IDS=1
AITER_GFX12_TOKEN_SPLIT_FUSED=1
ATOM_FUSED_TOPK_TOPP_SAMPLE=1
# MoE-block and attention-reduce kernels (ROCm/ATOM#3045): split-KV attention reduce with the output gate; router +
# shared expert in one kernel (decode) or one GEMM (prefill); top-k + route/psum + MXFP4 quant fused; gather-reduce +
# tail RMSNorm fused, software-pipelined at prefill sizes.
ATOM_UA_SPLIT_REDUCE=1
ATOM_FUSED_ROUTER_SHARED_EXPERT=1
ATOM_MOE_FUSED_TOPK_ROUTE_QUANT=1
ATOM_MOE_GATHER_TAIL_NORM=1
ATOM_MOE_GATHER_TAIL_NORM_PIPE=1
# GDN verify (spec decode) in the matrix form with 8 waves; its value heads split over programs at <= 8 sequences and
# the two heads' products unrolled (both bit-identical to the matrix form).
AITER_GDN_VERIFY_MATRIX=1
AITER_GDN_VERIFY_CHUNK_WARPS=8
AITER_GDN_VERIFY_SPLIT=2
AITER_GDN_VERIFY_UNROLL=1
# GDN state checkpoints read from the chunk kernel's interior states instead of cutting prefill chunks onto them
# (#2591): about half the TTFT at a given interval, so the decode intervals below are about twice the 11-05/06 ones.
ATOM_GDN_STATE_MIDSTEP=1
# API server: request preparation in 64 tokenize processes (#3018), with each session's earlier turns' token ids
# reused (#3046).
ATOM_API_OFFLOAD_PREPROCESS=1
ATOM_TOKENIZE_PROCESSES=64
ATOM_API_OFFLOAD_TOKENIZE_CACHE_MB=256
# Projections: 1x32 MXFP8 (fp8 e4m3 + one e8m0 scale per 32 K on both operands) for the 80 language-model
# projections, the activation quant fused into the producers where they allow it. Inline accuracy unchanged at c128
# (56.65% vs bf16 56.59%, complete runs). FP8_PROJ=0 keeps #3044's 1x128 e8m0 path off.
FP8_PROJ=0
ATOM_MXFP8_1X32=1
