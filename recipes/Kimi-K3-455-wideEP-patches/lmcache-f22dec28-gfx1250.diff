+def _producer_handle(event_backend: Any, event: Any, device: Any) -> bytes:
+    """IPC handle of the engine's producer event for the server to wait on.
+
+    On HIP an interprocess event cannot be relied on (``hipIpcOpenEventHandle``
+    failed or spun on gfx1250 with ROCm 10.1), so the worker waits for its
+    producer event here and sends none; the server then has nothing to wait on.
+    """
+    if getattr(torch.version, "hip", None):
+        event_backend.synchronize_event(event, device)
+        return b""
+    return event_backend.export_event(event, device)
+
