+def _completion_handle(event_backend: Any, event: Any, device: Any) -> bytes:
+    """Return the IPC handle a client waits on for this transfer.
+
+    On HIP the engine worker cannot reliably open the server's interprocess
+    event: on gfx1250 with ROCm 10.1, ``hipIpcOpenEventHandle`` in the worker
+    returned ``hipErrorInvalidValue`` or spun in its main thread. So the server
+    waits for its own transfer here and returns no event; the client then takes
+    the reply itself as the transfer's completion.
+    """
+    # Third Party
+    import torch
+
+    if getattr(torch.version, "hip", None):
+        event_backend.synchronize_event(event, device)
+        return b""
+    return event_backend.export_event(event, device)
+
