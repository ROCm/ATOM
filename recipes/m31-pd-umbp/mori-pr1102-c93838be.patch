+// What tells one cut of a slot from another in the store's key space.
+uint64_t HashUnits(uint64_t hash, uint64_t value) {
+  for (int i = 0; i < 8; ++i) {
+    hash ^= (value >> (8 * i)) & 0xFF;
+    hash *= 1099511628211ULL;  // FNV-1a
+  }
+  return hash;
+}
 
