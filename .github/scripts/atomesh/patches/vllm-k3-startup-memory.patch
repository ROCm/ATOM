+"""Startup memory observations; diagnostic branch only."""
+
+import json
+import os
+import time
+
+import torch
+
+from vllm.logger import init_logger
+from vllm.v1.worker import workspace
+
+logger = init_logger(__name__)
+
+
+def log_startup_memory(stage: str, **fields) -> None:
+    free, total = torch.accelerator.get_memory_info()
+    stats = torch.cuda.memory_stats()
+    manager = workspace._manager
+    payload = {
+        "stage": stage,
+        "pid": os.getpid(),
+        "monotonic_ns": time.monotonic_ns(),
+        "device": torch.cuda.current_device(),
+        "free_bytes": free,
+        "total_bytes": total,
+        "allocated_bytes": stats.get("allocated_bytes.all.current"),
+        "reserved_bytes": stats.get("reserved_bytes.all.current"),
+        "active_bytes": stats.get("active_bytes.all.current"),
+        "inactive_split_bytes": stats.get("inactive_split_bytes.all.current"),
+        "peak_allocated_bytes": stats.get("allocated_bytes.all.peak"),
+        "workspace_bytes": (
+            [manager._workspace_size_bytes(ws) for ws in manager._current_workspaces]
+            if manager is not None
+            else None
+        ),
+        "workspace_locked": manager.is_locked() if manager is not None else None,
+        **fields,
+    }
+    logger.info(
+        "K3_STARTUP_MEMORY %s", json.dumps(payload, sort_keys=True, allow_nan=False)
+    )
