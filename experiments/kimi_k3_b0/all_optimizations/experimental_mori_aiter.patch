diff --git a/op_tests/multigpu_tests/test_kimi_k3_mori_ep_scatter_tile.py b/op_tests/multigpu_tests/test_kimi_k3_mori_ep_scatter_tile.py
new file mode 100644
index 000000000..0327c735c
--- /dev/null
+++ b/op_tests/multigpu_tests/test_kimi_k3_mori_ep_scatter_tile.py
@@ -0,0 +1,369 @@
+# SPDX-License-Identifier: MIT
+# Copyright (C) 2024-2026, Advanced Micro Devices, Inc. All rights reserved.
+"""Focused EP4 regression for Kimi-K3's Mori GEMM2-scatter A4W4 tile.
+
+Launch with::
+
+    torchrun --standalone --nproc_per_node=4 \
+      op_tests/multigpu_tests/test_kimi_k3_mori_ep_scatter_tile.py
+
+The test requires four gfx1250 GPUs and a Mori version that exposes
+``TokOffExt``. It uses the production Mori dispatch, Stage2ScatterContext,
+GEMM2 CCO scatter and fused combine; no transport stage is simulated.
+"""
+
+from __future__ import annotations
+
+import os
+
+import torch
+from bench_mega_moe import (
+    Dist,
+    RefModel,
+    make_routings,
+    make_shared_weights,
+    raw_quant_weights,
+    shuffle_group,
+)
+
+from aiter import ActivationType, QuantType, dtypes, get_torch_quant
+from aiter.fused_moe import situv2
+from aiter.ops.flydsl.kernels import mega_moe_gfx1250 as mega_package
+from aiter.ops.flydsl.moe_common import GateMode
+from aiter.utility import fp4_utils
+
+WORLD = 4
+EXPERTS = 224
+LOCAL_EXPERTS = 56
+TOPK = 16
+HIDDEN = 3584
+INTER = 3072
+MAX_TOKENS = 2
+
+
+def _activation_dequant(x):
+    quant = get_torch_quant(QuantType.per_1x32)
+    packed, scale = quant(x, quant_dtype=dtypes.fp4x2)
+    values = fp4_utils.mxfp4_to_f32(packed).view_as(x)
+    scales = fp4_utils.e8m0_to_f32(scale).view(x.shape[0], HIDDEN // 32)
+    return values.float() * scales.unsqueeze(-1).expand(-1, -1, 32).reshape_as(x)
+
+
+class KimiReference(RefModel):
+    @staticmethod
+    def _ffn(x, w1, w2):
+        gate, up = (x @ w1.t()).chunk(2, dim=-1)
+        return situv2(gate, up, beta=4.0, linear_beta=25.0) @ w2.t()
+
+    def layer(self, x, ids, weights):
+        x = _activation_dequant(x.to(torch.bfloat16))
+        out = torch.zeros_like(x)
+        ids64 = ids.long()
+        for expert in torch.unique(ids64).tolist():
+            selected = ids64 == expert
+            rows = selected.any(dim=1)
+            route_weight = (weights * selected).sum(dim=1)
+            w1, w2 = self._expert(int(expert))
+            out[rows] += route_weight[rows, None] * self._ffn(x[rows], w1, w2)
+        return out
+
+    def run(self, x, routings):
+        for ids, weights in routings:
+            x = self.layer(x.float(), ids, weights)
+        return x.to(torch.bfloat16)
+
+
+class ObservedMegaMoE(mega_package.MegaMoEGfx1250):
+    def _scatter_context(self, routing, combine_quant_bits):
+        context = super()._scatter_context(routing, combine_quant_bits)
+        assert context.world_size == WORLD
+        assert context.max_tokens_per_rank == MAX_TOKENS
+        assert context.source_token_map.dtype == torch.int32
+        assert context.source_token_map.is_contiguous()
+        assert context.direct_ep_route
+        assert not context.fuse_psum_quant
+        self.last_scatter = context
+        return context
+
+
+def _routes(pattern, tokens, rank, device):
+    if pattern in ("random", "extreme"):
+        return make_routings(1, tokens, EXPERTS, TOPK, device, 4242 + 100 * rank)[0]
+    if pattern == "empty":
+        row = torch.arange(TOPK, dtype=torch.int32, device=device)
+    elif pattern == "duplicate":
+        row = torch.full((TOPK,), LOCAL_EXPERTS - 1, dtype=torch.int32, device=device)
+    elif pattern == "tail":
+        row = torch.tensor(
+            [
+                peer * LOCAL_EXPERTS + expert
+                for peer in range(WORLD)
+                for expert in range(LOCAL_EXPERTS - 4, LOCAL_EXPERTS)
+            ],
+            dtype=torch.int32,
+            device=device,
+        )
+    else:
+        raise ValueError(pattern)
+    ids = row.expand(tokens, -1).clone()
+    generator = torch.Generator(device=device).manual_seed(9000 + rank)
+    weights = torch.rand(
+        (tokens, TOPK), dtype=torch.float32, generator=generator, device=device
+    )
+    weights /= weights.sum(dim=-1, keepdim=True)
+    return ids, weights.contiguous()
+
+
+def _logits_diff(reference, actual):
+    reference = reference.double()
+    actual = actual.double()
+    denominator = (reference.square() + actual.square()).sum()
+    if not denominator:
+        return 0.0 if torch.equal(reference, actual) else float("inf")
+    return float(1 - 2 * (reference * actual).sum() / denominator)
+
+
+def _check_config_rows():
+    from aiter.ops.flydsl.grouped_moe_gfx1250 import _find_grouped_config
+
+    _find_grouped_config.cache_clear()
+    for token in (4, 8, 16, 32, 64, 128):
+        row = _find_grouped_config(
+            token_num=token,
+            model_dim=HIDDEN,
+            inter_dim=INTER,
+            experts=LOCAL_EXPERTS,
+            topk=-1,
+            activation=ActivationType.Situv2,
+            dtype=dtypes.bf16,
+            q_dtype_a=dtypes.fp4x2,
+            q_dtype_w=dtypes.fp4x2,
+            quant_type=QuantType.per_1x32,
+            ep_fused=True,
+        )
+        assert row is not None
+        assert tuple(int(row[name]) for name in ("tile_m", "tile_n", "tile_k")) == (
+            16,
+            256,
+            128,
+        )
+        assert tuple(int(row[name]) for name in ("tile_m2", "tile_n2", "tile_k2")) == (
+            16,
+            256,
+            128,
+        )
+
+
+def main():
+    if torch.cuda.device_count() != WORLD:
+        print(f"SKIP: requires {WORLD} visible GPUs")
+        return
+    for name in (
+        "AITER_TDM_TILE_M",
+        "AITER_TDM_TILE_N",
+        "AITER_TDM_TILE_K",
+        "AITER_TDM_TILE_M2",
+        "AITER_TDM_TILE_N2",
+        "AITER_TDM_TILE_K2",
+    ):
+        assert name not in os.environ, f"production config test forbids {name}"
+
+    dist_ctx = Dist()
+    device = torch.device("cuda", dist_ctx.local_rank)
+    _check_config_rows()
+    w1, w2, _, _ = make_shared_weights(
+        EXPERTS,
+        HIDDEN,
+        INTER,
+        dtypes.bf16,
+        device,
+        seed=70000,
+    )
+    begin = dist_ctx.rank * LOCAL_EXPERTS
+    local_w1 = w1[begin : begin + LOCAL_EXPERTS].contiguous()
+    local_w2 = w2[begin : begin + LOCAL_EXPERTS].contiguous()
+    q1, s1, q2, s2 = raw_quant_weights(local_w1, local_w2)
+    spec = {
+        "key": "a4w4_mxfp4",
+        "aiter_qtype": QuantType.per_1x32,
+        "gate_mode": GateMode.INTERLEAVE,
+        "activation": ActivationType.Situv2,
+    }
+    w1_kernel, w2_kernel, s1_kernel, s2_kernel = shuffle_group(
+        q1, s1, q2, s2, spec, LOCAL_EXPERTS
+    )
+
+    from mori.cco import Communicator
+    from mori.ops.dispatch_combine_v2.hip_backend import TokOffExt  # noqa: F401
+
+    uid = Communicator.get_unique_id() if dist_ctx.rank == 0 else None
+    uid = dist_ctx.bcast_uid(uid)
+    communicator = Communicator.init(
+        WORLD, dist_ctx.rank, uid, per_rank_vmm=16 * 1024**3
+    )
+    mega = ObservedMegaMoE(
+        communicator=communicator,
+        rank=dist_ctx.rank,
+        world_size=WORLD,
+        model_dim=HIDDEN,
+        inter_dim=INTER,
+        experts=EXPERTS,
+        topk=TOPK,
+        max_tokens_per_rank=MAX_TOKENS,
+        activation=ActivationType.Situv2,
+        gate_mode=GateMode.INTERLEAVE.value,
+        quant_type=QuantType.per_1x32,
+        situ_beta=4.0,
+        situ_linear_beta=25.0,
+        dispatch_backend="mori",
+        dispatch_wire="fp4",
+    )
+    reference = KimiReference(w1, w2, None, None, spec, device)
+
+    import aiter.ops.flydsl.grouped_gemm_mxfp4 as grouped_gemm
+
+    original = grouped_gemm.flydsl_grouped_gemm_a8w4_masked
+    rowmaps = []
+
+    def observe(*args, **kwargs):
+        if kwargs.get("stage2_scatter") is not None:
+            rowmap = kwargs["ep_row_map"]
+            assert rowmap.dtype == torch.int32 and rowmap.shape[1] == 2
+            rowmaps.append(rowmap)
+        return original(*args, **kwargs)
+
+    grouped_gemm.flydsl_grouped_gemm_a8w4_masked = observe
+    try:
+        for pattern, tokens in (
+            ("random", 1),
+            ("empty", 2),
+            ("tail", 1),
+            ("duplicate", 2),
+            ("extreme", 2),
+        ):
+            storage = torch.empty(
+                (tokens + 2, HIDDEN), dtype=torch.bfloat16, device=device
+            )
+            storage[0].fill_(113.0)
+            storage[-1].fill_(-117.0)
+            generator = torch.Generator(device=device).manual_seed(1000 + dist_ctx.rank)
+            storage[1:-1].normal_(generator=generator)
+            hidden = storage[1:-1]
+            if pattern == "extreme":
+                values = torch.tensor(
+                    [-512.0, -1.0, -0.0, 0.0, 1.0, 512.0],
+                    dtype=torch.bfloat16,
+                    device=device,
+                )
+                hidden.view(-1).copy_(
+                    values.repeat(
+                        (hidden.numel() + values.numel() - 1) // values.numel()
+                    )[: hidden.numel()]
+                )
+            guards = storage[[0, -1]].clone()
+            ids, weights = _routes(pattern, tokens, dist_ctx.rank, device)
+            all_ids = [torch.empty_like(ids) for _ in range(WORLD)]
+            torch.distributed.all_gather(all_ids, ids)
+            global_ids = torch.cat(all_ids).reshape(-1)
+            local = global_ids[
+                (global_ids >= begin) & (global_ids < begin + LOCAL_EXPERTS)
+            ]
+            expected_counter = torch.bincount(
+                local.to(torch.int64) - begin, minlength=LOCAL_EXPERTS
+            ).to(torch.int32)
+
+            args = {
+                "w1": w1_kernel,
+                "w2": w2_kernel,
+                "w1_scale": s1_kernel,
+                "w2_scale": s2_kernel,
+            }
+            os.environ["AITER_TDM_DIRECT_EP_MASK"] = "0"
+            baseline = mega(hidden, weights, ids, **args).clone()
+            os.environ["AITER_TDM_DIRECT_EP_MASK"] = "1"
+            actual = mega(hidden, weights, ids, **args).clone()
+            repeated = mega(hidden, weights, ids, **args).clone()
+            torch.cuda.synchronize()
+            assert torch.equal(actual, baseline)
+            assert torch.equal(actual, repeated)
+            assert torch.equal(storage[[0, -1]], guards)
+            assert torch.isfinite(actual).all()
+            expected = reference.run(hidden, [(ids, weights)]).float()
+            diff = _logits_diff(expected, actual.float())
+            assert diff < 0.02, f"{pattern}: logits_diff={diff}"
+
+            total_recv = int(mega._total_recv.item())
+            source = mega.last_scatter.source_token_map[:total_recv]
+            assert bool(((source >= 0) & (source < WORLD * MAX_TOKENS)).all())
+            assert torch.equal(mega._route_counter, expected_counter), (
+                pattern,
+                dist_ctx.rank,
+                mega._route_counter.tolist(),
+                expected_counter.tolist(),
+            )
