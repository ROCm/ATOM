diff --git a/tests/model_ops/test_k3_causal_conv1d_prefill.py b/tests/model_ops/test_k3_causal_conv1d_prefill.py
new file mode 100644
index 000000000..1e2850da1
--- /dev/null
+++ b/tests/model_ops/test_k3_causal_conv1d_prefill.py
@@ -0,0 +1,147 @@
+from types import SimpleNamespace
+
+import pytest
+import torch
+from atom.model_ops.mamba_ops.causal_conv1d import causal_conv1d_fn
+
+DIM = 36864
+K_DIM = 12288
+ROW_STRIDE = 49376
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available()
+    or torch.cuda.get_device_properties(0).gcnArchName != "gfx1250",
+    reason="K3 long-prefill specialization requires gfx1250",
+)
+
+
+def _metadata(lengths):
+    counts = torch.tensor([(length + 7) // 8 for length in lengths])
+    sequence_ids = torch.repeat_interleave(
+        torch.arange(len(lengths), dtype=torch.int32), counts
+    )
+    starts = counts.cumsum(0) - counts
+    chunk_ids = (
+        torch.arange(int(counts.sum())) - torch.repeat_interleave(starts, counts)
+    ).to(torch.int32)
+    sequence_ids = sequence_ids.cuda()
+    chunk_ids = chunk_ids.cuda()
+    entry = {
+        "tot": int(counts.sum()),
+        "mlist": None,
+        "mlist_len": int(counts.sum()),
+        "offsetlist": None,
+        "batch_ptr": sequence_ids,
+        "token_chunk_offset_ptr": chunk_ids,
+    }
+    return SimpleNamespace(
+        nums_dict={8: entry},
+        batch_ptr=sequence_ids,
+        token_chunk_offset_ptr=chunk_ids,
+        has_state_fork=False,
+    )
+
+
+def _reference(x, weight, state, query_start_loc, slots, has_initial_state):
+    output = torch.empty((x.shape[1], DIM), device=x.device, dtype=torch.float32)
+    final_state = state.float().clone()
+    for sequence, (start, stop) in enumerate(
+        zip(query_start_loc[:-1].tolist(), query_start_loc[1:].tolist())
+    ):
+        slot = int(slots[sequence])
+        prefix = (
+            state[slot].transpose(0, 1).float()
+            if bool(has_initial_state[sequence])
+            else torch.zeros(3, DIM, device=x.device)
+        )
+        values = torch.cat((prefix, x[:, start:stop].transpose(0, 1).float()))
+        acc = torch.zeros((stop - start, DIM), device=x.device)
+        for tap in range(4):
+            acc.add_(values[tap : tap + stop - start] * weight[:, tap].float())
+        output[start:stop] = acc * torch.sigmoid(acc)
+        final_state[slot] = values[-3:].transpose(0, 1)
+    return output, final_state
+
+
+@pytest.mark.parametrize("lengths", [[2048], [1, 7, 249, 1791]])
+def test_k3_long_prefill_tile_matches_fp32_and_generic(lengths):
+    torch.manual_seed(7100 + len(lengths))
+    total = sum(lengths)
+    fused = torch.randn(total, ROW_STRIDE, device="cuda", dtype=torch.bfloat16) * 0.1
+    x = fused[:, :DIM].transpose(0, 1)
+    weight = torch.randn(DIM, 4, device="cuda", dtype=torch.bfloat16) * 0.1
+    state = (
+        torch.randn(
+            len(lengths), 3, DIM, device="cuda", dtype=torch.bfloat16
+        ).transpose(1, 2)
+        * 0.1
+    )
+    query_start_loc = torch.tensor(
+        [0, *torch.tensor(lengths).cumsum(0).tolist()],
+        device="cuda",
+        dtype=torch.int32,
+    )
+    slots = torch.roll(torch.arange(len(lengths), device="cuda", dtype=torch.int32), 1)
+    has_initial_state = torch.tensor(
+        [(index % 3) != 1 for index in range(len(lengths))],
+        device="cuda",
+        dtype=torch.bool,
+    )
+    metadata = _metadata(lengths)
+
+    candidate_state = state.clone()
+    candidate = torch.cat(
+        causal_conv1d_fn(
+            x,
+            weight,
+            None,
+            candidate_state,
+            query_start_loc,
+            K_DIM,
+            K_DIM,
+            slots,
+            slots.clone(),  # native metadata uses a distinct fixed-address buffer
+            has_initial_state,
+            "silu",
+            metadata=metadata,
+        ),
+        dim=1,
+    )
+
+    generic_state = state.clone()
+    generic_metadata = _metadata(lengths)
+    generic_metadata.has_state_fork = True
+    generic = torch.cat(
+        causal_conv1d_fn(
+            x,
+            weight,
+            None,
+            generic_state,
+            query_start_loc,
+            K_DIM,
+            K_DIM,
+            slots,
+            slots.clone(),  # equal values; fork flag below forces the fallback
+            has_initial_state,
+            "silu",
+            metadata=generic_metadata,
+        ),
+        dim=1,
+    )
+    reference, reference_state = _reference(
+        x, weight, state, query_start_loc, slots, has_initial_state
+    )
+
+    candidate_error = (candidate.float() - reference).abs()
+    generic_error = (generic.float() - reference).abs()
+    assert float(candidate_error.max()) <= float(generic_error.max()) + 1e-7
+    assert float(candidate_error.mean()) <= float(generic_error.mean()) + 1e-9
+    torch.testing.assert_close(
+        candidate.float(),
+        reference,
+        rtol=0,
+        atol=float(generic_error.max()),
+    )
+    assert not torch.equal(candidate, generic)
+    assert torch.equal(candidate_state, generic_state)
+    assert torch.equal(candidate_state, reference_state.to(torch.bfloat16))
