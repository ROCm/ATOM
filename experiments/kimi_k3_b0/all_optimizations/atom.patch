+from types import SimpleNamespace
+
+import pytest
+import torch
+
+try:
+    from aiter.ops.triton.attention import mla_decode
+
+    from atom.model_ops import attention_mla
+    from atom.model_ops.attention_mla import MLAAttention
+    from atom.model_ops.attentions.triton_mla import _use_k3_split8
+
+    _IMPORT_ERR = None
+except ImportError as error:
+    _IMPORT_ERR = str(error)
+
+pytestmark = pytest.mark.skipif(
+    _IMPORT_ERR is not None, reason=f"requires full atom import env: {_IMPORT_ERR}"
+)
+
+
+def _k3_contract(**overrides):
+    values = {
+        "arch": "gfx1250",
+        "model_dtype": torch.bfloat16,
+        "kv_cache_dtype": "fp8",
+        "num_heads": 96,
+        "page_size": 1,
+        "max_batch_size": 8,
+        "shuffle_kv": False,
+    }
+    values.update(overrides)
+    hf = SimpleNamespace(
+        model_type="kimi_linear",
+        kv_lora_rank=512,
+        qk_nope_head_dim=128,
+        qk_rope_head_dim=64,
+        v_head_dim=128,
+    )
+    return hf, values
+
+
+def test_split8_scratch_is_limited_to_the_measured_k3_contract():
+    hf, values = _k3_contract()
+    assert _use_k3_split8(hf, **values)
+
+    for field, other in (
+        ("arch", "gfx942"),
+        ("model_dtype", torch.float16),
+        ("kv_cache_dtype", "bf16"),
+        ("num_heads", 128),
+        ("page_size", 64),
+        ("max_batch_size", 16),
+        ("shuffle_kv", True),
+    ):
+        hf, values = _k3_contract(**{field: other})
+        assert not _use_k3_split8(hf, **values), field
+
+    for field, other in (
+        ("model_type", "deepseek_v3"),
+        ("kv_lora_rank", 256),
+        ("qk_nope_head_dim", 64),
+        ("qk_rope_head_dim", 32),
+        ("v_head_dim", 256),
+    ):
+        hf, values = _k3_contract()
+        setattr(hf, field, other)
+        assert not _use_k3_split8(hf, **values), field
+
+
+@pytest.mark.parametrize(
+    "batch_size,scratch_splits,expected",
+    [(1, 8, 8), (2, 8, 8), (4, 8, 4), (8, 8, 4), (1, 4, 4)],
+)
+def test_decode_split_selection_is_batch_static_and_capacity_safe(
+    monkeypatch, batch_size, scratch_splits, expected
+):
+    seen = {}
+
+    def fake_decode(*args, **kwargs):
+        seen["logits"] = args[7]
+        seen["splits"] = args[8]
+
+    monkeypatch.setattr(mla_decode, "decode_attention_fwd", fake_decode)
+    monkeypatch.setattr(attention_mla.envs, "ATOM_USE_TRITON_MLA", True)
+    monkeypatch.setattr(attention_mla.envs, "ATOM_USE_TRITON_MLA_SHUFFLE_KV", False)
+
+    attn = MLAAttention.__new__(MLAAttention)
+    attn.head_pad = 0
+    attn.dcp_world_size = 1
+    attn.use_seg_mla = False
+    attn.num_heads = 2
+    attn.kv_lora_rank = 8
+    attn.qk_rope_head_dim = 4
+    attn.dtype = torch.float32
+    attn.scale = 1.0
+    attn._k_scale = torch.ones((), dtype=torch.float32)
+    attn._v_up_proj_and_o_proj = lambda output: output
+
+    logits = torch.empty(batch_size, 2, scratch_splits, 9)
+    metadata = SimpleNamespace(
+        causal=True,
+        triton_block_table=torch.zeros(batch_size, 1, dtype=torch.int32),
+        context_lens=torch.ones(batch_size, dtype=torch.int32),
+        triton_attn_logits=logits,
+        triton_lse=torch.empty(batch_size, 2),
+    )
+    q = torch.empty(batch_size, 2, 12)
+    kv_cache = torch.empty(1, 1, 12)
+
+    attn._forward_decode(q, kv_cache, metadata)
+
+    assert seen["splits"] == expected
+    assert seen["logits"].shape[2] == expected
+    assert seen["logits"].data_ptr() == logits.data_ptr()
