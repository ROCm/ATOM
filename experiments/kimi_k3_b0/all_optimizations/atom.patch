+from __future__ import annotations
+
+import pytest
+import torch
+
+from atom.model_ops.kimi_k3 import attention_residual
+from atom.model_ops.kimi_k3.attention_residual import _apply_attn_res_impl
+
+HIDDEN = 7168
+EPS = 1e-6
+
+
+def test_attn_res_gfx1250_long_prefill_config_guard(monkeypatch) -> None:
+    monkeypatch.setattr(attention_residual, "_is_gfx1250", lambda _device: True)
+    pick = attention_residual._pick_attn_res_config
+    assert pick(2047, HIDDEN, 0) == (4, 2, 2)
+    assert pick(2048, HIDDEN, 0) == (4, 2, 1)
+    assert pick(16384, HIDDEN, 0) == (4, 2, 1)
+    assert pick(2048, HIDDEN // 2, 0) == (4, 2, 2)
+
+    monkeypatch.setattr(attention_residual, "_is_gfx1250", lambda _device: False)
+    assert pick(2048, HIDDEN, 0) == (4, 2, 2)
+
+
+@pytest.mark.skipif(not torch.cuda.is_available(), reason="requires a GPU")
+def test_attn_res_gfx1250_long_prefill_matches_reference() -> None:
+    arch = getattr(torch.cuda.get_device_properties(0), "gcnArchName", "")
+    if arch.split(":", 1)[0] != "gfx1250":
+        pytest.skip("the production tuning target is gfx1250")
+
+    tokens = 2048
+    generator = torch.Generator(device="cuda").manual_seed(20261004)
+    prefix = torch.randn(
+        (tokens, HIDDEN), generator=generator, device="cuda", dtype=torch.bfloat16
+    )
+    block = torch.randn(
+        (tokens, 1, HIDDEN),
+        generator=generator,
+        device="cuda",
+        dtype=torch.bfloat16,
+    )
+    score_weight = (
+        torch.randn(HIDDEN, generator=generator, device="cuda", dtype=torch.float32)
+        / HIDDEN
+    )
+
+    candidates = torch.cat((block.float(), prefix[:, None].float()), dim=1)
+    rstd = torch.rsqrt(candidates.square().mean(dim=-1) + EPS)
+    scores = (candidates * score_weight).sum(dim=-1) * rstd
+    expected = (
+        (torch.softmax(scores, dim=1)[:, :, None] * candidates)
+        .sum(dim=1)
+        .to(torch.bfloat16)
+    )
+
+    actual, prefix_out = _apply_attn_res_impl(prefix, block, score_weight, EPS)
+
+    assert prefix_out is prefix
+    torch.testing.assert_close(actual, expected, rtol=0.008, atol=0.002)
