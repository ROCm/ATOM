+++ b/tests/model_ops/test_causal_conv1d_update.py
@@ -0,0 +1,173 @@
+import pytest
+import torch
+from atom.model_ops.mamba_ops.causal_conv1d import causal_conv1d_update
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available(), reason="causal conv requires a GPU"
+)
+
+
+def _reference_one_token(
+    x, state, weight, read_slots, write_slots, bias=None, activation="silu"
+):
+    history = state[read_slots].float()
+    values = torch.cat((history, x.float().unsqueeze(-1)), dim=-1)
+    output = (values * weight.float().unsqueeze(0)).sum(-1)
+    if bias is not None:
+        output += bias.float()
+    if activation == "silu":
+        output = output / (1.0 + torch.exp(-output))
+    expected_state = state.clone()
+    expected_state[write_slots] = torch.cat(
+        (history[..., 1:], x.float().unsqueeze(-1)), dim=-1
+    ).to(state.dtype)
+    return output, expected_state
+
+
+@pytest.mark.parametrize("batch", [1, 2, 4, 8])
+def test_width4_single_token_update_matches_fp32_reference(batch):
+    torch.manual_seed(1701 + batch)
+    k_dim = 257  # Exercises both BLOCK_N and q/k/v tails.
+    dim = 3 * k_dim
+    slots = 2 * batch + 8
+    state = torch.randn(slots, 3, dim, device="cuda", dtype=torch.bfloat16).transpose(
+        1, 2
+    )
+    reference_state = state.clone(memory_format=torch.preserve_format)
+    weight = 0.1 * torch.randn(dim, 4, device="cuda", dtype=torch.bfloat16)
+    bias = 0.1 * torch.randn(dim, device="cuda", dtype=torch.bfloat16)
+
+    for step in range(32):
+        x_storage = torch.randn(batch, dim + 19, device="cuda", dtype=torch.bfloat16)
+        x = x_storage[:, :dim]
+        if step in (7, 19):
+            x[:, 0::3] = 100
+            x[:, 1::3] = -100
+
+        permutation = torch.randperm(slots, device="cuda")
+        if step % 7 == 3:
+            read_slots = permutation[:batch]
+            write_slots = permutation[batch : 2 * batch]
+        else:
+            read_slots = permutation[:batch]
+            write_slots = read_slots
+
+        expected_output, expected_state = _reference_one_token(
+            x,
+            reference_state,
+            weight,
+            read_slots,
+            write_slots,
+            bias,
+            activation=None,
+        )
+        query, key, value = causal_conv1d_update(
+            x,
+            state,
+            weight,
+            k_dim,
+            k_dim,
+            bias,
+            None,
+            conv_state_indices=write_slots.to(torch.int32),
+            conv_state_indices_in=read_slots.to(torch.int32),
+        )
+        output = torch.cat((query, key, value), dim=-1)
+
+        torch.testing.assert_close(output.float(), expected_output, rtol=0.02, atol=0.1)
+        assert torch.equal(state, expected_state)
+        reference_state.copy_(expected_state)
+
+
+@pytest.mark.parametrize("layout", ["logical", "physical", "strided"])
+def test_width4_single_token_update_layout_fork_and_pad(layout):
+    torch.manual_seed(1801)
+    k_dim = 129
+    dim = 3 * k_dim
+    if layout == "logical":
+        state = torch.randn(12, dim, 3, device="cuda", dtype=torch.bfloat16)
+    elif layout == "physical":
+        state = torch.randn(12, 3, dim, device="cuda", dtype=torch.bfloat16).transpose(
+            1, 2
+        )
+    else:
+        storage = torch.randn(12, 5, 2 * dim + 7, device="cuda", dtype=torch.bfloat16)
+        state = storage[:, :3, : 2 * dim : 2].transpose(1, 2)
+
+    before = state.clone()
+    weight = torch.randn(dim, 4, device="cuda", dtype=torch.bfloat16)
+    x = torch.randn(4, dim + 11, device="cuda", dtype=torch.bfloat16)[:, :dim]
+    read_slots = torch.tensor([1, -1, 3, 4], device="cuda", dtype=torch.int32)
+    write_slots = torch.tensor([7, -1, 8, 9], device="cuda", dtype=torch.int32)
+    query, key, value = causal_conv1d_update(
+        x,
+        state,
+        weight,
+        k_dim,
+        k_dim,
+        None,
+        "silu",
+        conv_state_indices=write_slots,
+        conv_state_indices_in=read_slots,
+    )
+
+    active = torch.tensor([0, 2, 3], device="cuda")
+    expected_output, expected_state = _reference_one_token(
+        x[active],
+        before,
+        weight,
+        read_slots[active].long(),
+        write_slots[active].long(),
+    )
+    output = torch.cat((query, key, value), dim=-1)
+    torch.testing.assert_close(
+        output[active].float(), expected_output, rtol=0.02, atol=0.05
+    )
+    assert torch.equal(state, expected_state)
+    assert torch.equal(state[1], before[1])
+
+
+def test_varlen_and_apc_keep_generic_update():
+    k_dim = 129
+    dim = 3 * k_dim
+    weight = torch.ones(dim, 4, device="cuda", dtype=torch.bfloat16)
+
+    state = torch.ones(12, dim, 3, device="cuda", dtype=torch.bfloat16)
+    slots = torch.tensor([2, 5], device="cuda", dtype=torch.int32)
+    query_start_loc = torch.tensor([0, 1, 3], device="cuda", dtype=torch.int32)
+    x = torch.full((3, dim), 2, device="cuda", dtype=torch.bfloat16)
+    output = causal_conv1d_update(
+        x,
+        state,
+        weight,
+        k_dim,
+        k_dim,
+        None,
+        None,
+        conv_state_indices=slots,
+        query_start_loc=query_start_loc,
+        max_query_len=2,
+    )
+    assert torch.equal(
+        torch.cat(output, dim=-1), x.new_tensor([5, 5, 6])[:, None].expand(-1, dim)
+    )
+    assert torch.equal(state[2, :, :], x.new_tensor([1, 2, 1]).expand(dim, -1))
+    assert torch.equal(state[5, :, :], x.new_tensor([1, 2, 2]).expand(dim, -1))
+
+    state.fill_(1)
+    table = torch.tensor([[1, 6], [3, 8]], device="cuda", dtype=torch.int32)
+    output = causal_conv1d_update(
+        x[:2],
+        state,
+        weight,
+        k_dim,
+        k_dim,
+        None,
+        None,
+        conv_state_indices=table,
+        block_idx_last_scheduled_token=torch.ones(2, device="cuda", dtype=torch.int32),
+        initial_state_idx=torch.zeros(2, device="cuda", dtype=torch.int32),
+    )
+    assert torch.equal(torch.cat(output, dim=-1), x.new_full((2, dim), 5))
+    assert torch.equal(state[6], x.new_tensor([1, 1, 2]).expand(dim, -1))
+    assert torch.equal(state[8], x.new_tensor([1, 1, 2]).expand(dim, -1))
